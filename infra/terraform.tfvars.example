# Copy this file to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored to protect sensitive values

project_id  = "your-gcp-project-id"
region      = "us-central1"
environment = "prod"
alert_email = "your-email@example.com"

# Optional: Restrict CORS to specific origins (default allows all)
# cors_origins = ["https://your-domain.web.app", "http://localhost:3000"]
